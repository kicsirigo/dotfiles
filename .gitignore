.config/themes/theme_switcher/backups/
**/__pycache__/
*.pyc

# Ignore compiled Hyprland configurations
.config/hypr/*.conf
.config/themes/*/hypr/.config/hypr/*.conf
!**/hyprlock.conf
!**/hypridle.conf
!**/hyprsunset.conf
!**/screenoff.conf
# Auto-generated PulseAudio session cookie
**/pulse/cookie

# Clipse runtime logs and temporary files
*.log
**/clipse/tmp_files/
**/clipse/clipse.log
**/clipse/clipboard_history.json
